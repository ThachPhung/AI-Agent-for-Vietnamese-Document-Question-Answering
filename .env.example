# GPU mode: set to "true" to use 4-bit quantization (requires NVIDIA GPU + bitsandbytes)
# CPU mode: set to "false" to use bfloat16 without quantization
USE_GPU=true

# LangChain Hub API key (required to pull prompt templates)
# Get your key at: https://smith.langchain.com/
LANGCHAIN_HUB_API_KEY=your_api_key_here
